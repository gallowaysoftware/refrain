# Copy to .env and replace every REPLACE- value before `docker compose up`.

# Free LAN IP for the refrain container on the macvlan network (br0).
REFRAIN_IPV4=REPLACE-with-a-free-lan-ip

# Host path for the memory root — a git repo of markdown, the only
# irreplaceable data in this stack. Back it up.
REFRAIN_DATA=REPLACE-with-a-host-path
